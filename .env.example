# Copier ce fichier en .env puis adapter les valeurs.

# Mot de passe du compte administrateur (obligatoire, choisissez-le long).
ADMIN_PASSWORD=change-moi

# true si le site est servi en HTTPS (Nginx Proxy Manager + Let's Encrypt).
# Le scan des boîtes avec la caméra ne marche QUE en HTTPS.
# Mettre false uniquement pour un test en http:// sans proxy.
COOKIE_SECURE=true

# Nom du réseau Docker de Nginx Proxy Manager (voir `docker network ls`).
PROXY_NETWORK=proxy

# Port publié sur 127.0.0.1 du serveur (accès local / tunnel SSH).
# 8000 est déjà pris par le site des calendriers.
HOST_PORT=8010
